# UI runtime configuration (read at request time; no rebuild needed).
# In Compose these are set by compose.yaml; for `npm run dev` copy this file
# to .env.local and adjust.

# live: questions go to the API. replay: only recorded sessions, no API calls.
UI_MODE=live

# Demo API (server-side only; the browser calls the same-origin /api/v1 proxy).
API_URL=http://127.0.0.1:8000

# Replay bundle: $PACKS_DIR/$DATA_PACK/recordings
PACKS_DIR=../data/packs
DATA_PACK=synthetic-market

# Browser-reachable Phoenix UI. Leave unset to hide the Phoenix link.
PHOENIX_URL=http://127.0.0.1:6006

# The composer's microphone (live mode only). The API transcribes the recording with NVIDIA
# Nemotron ASR; it needs SPEECH_INPUT_ENABLED and a key on its side too (api/README.md).
SPEECH_INPUT_ENABLED=false
SPEECH_INPUT_MAX_SECONDS=60
