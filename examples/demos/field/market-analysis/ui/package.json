{
  "name": "aiq-blueprint-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build && cp -R public .next/standalone/ && cp -R .next/static .next/standalone/.next/",
    "start": "HOSTNAME=127.0.0.1 node .next/standalone/server.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@nvidia/foundations-react-core": "^0.600.0",
    "@tailwindcss/postcss": "^4.1.18",
    "clsx": "^2.1.1",
    "katex": "^0.17.0",
    "mermaid": "^11.16.1",
    "motion": "^12.42.2",
    "next": "^16.3.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.0",
    "unist-util-visit": "^5.1.0",
    "uuid": "^14.0.2",
    "zod": "^3.24.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.7",
    "postcss": "^8.5.23",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "5.9.3"
  },
