#
# A Nemotron model answers over Chat Completions. A GPT model judges every completed turn; once it
# escalates, the capable GPT model (Responses API) serves the rest of the session. A Nemotron model
# serves Hermes' auxiliary and fallback calls. The GPT models come from the capable endpoint:
# CAPABLE_BASE_URL and CAPABLE_API_KEY, which default to the inference endpoint and key (the key only
# on that same endpoint). Switchyard keys a route's targets by model id, so the judge needs another id
# than the capable model: another id the provider lists for the same model, or another strong model.
# requires: INFERENCE_BASE_URL CAPABLE_BASE_URL AGENT_EFFICIENT_MODEL AGENT_CAPABLE_MODEL AGENT_JUDGE_MODEL AGENT_AUX_MODEL SWITCHYARD_CONFIRMATIONS
schema_version = 1

[llm_clients.chat]
format = "openai_chat"
base_url = "${INFERENCE_BASE_URL}"
api_key_env = "INFERENCE_API_KEY"
timeout_ms = 900000                   # whole call, stream included
max_retries = 0                       # Hermes retries 429 and 5xx itself

[llm_clients.responses]               # GPT tool calling needs the Responses API
format = "openai_responses"
base_url = "${CAPABLE_BASE_URL}"
api_key_env = "CAPABLE_API_KEY"
timeout_ms = 900000
max_retries = 0

[llm_clients.judge]                   # own client: a deadline that bounds each verdict
format = "openai_responses"
base_url = "${CAPABLE_BASE_URL}"
api_key_env = "CAPABLE_API_KEY"
timeout_ms = 120000                   # every attempt of one verdict
max_retries = 2                       # a verdict that still fails fails the agent's turn

[targets.efficient]
id = "${AGENT_EFFICIENT_MODEL}"
llm_client = "chat"
extra_body = { max_tokens = 16384 }   # only when the caller sets none

[targets.capable]
id = "${AGENT_CAPABLE_MODEL}"
llm_client = "responses"
reasoning_effort = "medium"           # Hermes sends no effort to a custom provider
extra_body = { store = false }

[targets.judge]                       # JSON-schema verdicts (Responses text.format)
id = "${AGENT_JUDGE_MODEL}"
llm_client = "judge"
reasoning_effort = "low"
extra_body = { store = false }

[targets.aux]                         # a Nemotron model: auxiliary and fallback calls, never judged
id = "${AGENT_AUX_MODEL}"
llm_client = "chat"
extra_body = { chat_template_kwargs = { enable_thinking = false } }

[routes.research]
id = "market-research"
type = "llm_classifier"
mode = "escalation"
weak_target = "efficient"
strong_target = "capable"
classifier_target = "judge"
response_format_type = "json_schema"  # "json_object" if the endpoint rejects JSON Schema
max_output_tokens = 4096
escalation = { confirmations = ${SWITCHYARD_CONFIRMATIONS}, recent_turn_window = 16, window_message_chars = 900 }
# The judge's system prompt is judge-prompt.md, inlined by entrypoint.sh.
prompt = '''
${JUDGE_PROMPT}
'''

[routes.efficient]
id = "market-research-efficient"
type = "passthrough"
target = "efficient"

[routes.capable]
id = "market-research-capable"
type = "passthrough"
target = "capable"

[routes.aux]                          # Hermes auxiliary calls, kept out of the judged route
id = "market-research-aux"
type = "passthrough"
target = "aux"

[routes.fallback]                     # Hermes moves a run here when its model is overloaded
id = "market-research-fallback"
type = "passthrough"
target = "aux"
