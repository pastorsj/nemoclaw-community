#
# The Kumo service's configuration (docs/kumo-service.md). Copy it to .env in this directory with mode 600:
#   (umask 077 && cp .env.example .env)
# .env is gitignored. Keep keys off command lines; the setup in docs/kumo-service.md writes them here directly.

# The key every request but /healthz must carry as X-API-Key: only A-Z, a-z, 0-9, _ and -, at least 32
# characters. Generate it with: openssl rand -hex 32
KUMO_SERVICE_API_KEY=
# While rotating, the old key, accepted beside the new one until every demo deployment has switched.
# Empty otherwise.
KUMO_SERVICE_PREVIOUS_API_KEY=

# The proxy's host port, which the HTTPS link points at, and the address it listens on: 0.0.0.0 for a link
# that connects over the host's network (a Brev link), or 127.0.0.1 for a tunnel that runs on this host.
KUMO_SERVICE_PORT=8080
KUMO_SERVICE_BIND=0.0.0.0

# The rate limit is per client address. Behind a link, every request comes from the link's proxy; to limit
# each client instead, set the proxy's addresses or CIDR ranges (comma-separated) here, and the client address
# comes from X-Forwarded-For. Empty: the connecting address.
KUMO_SERVICE_REAL_IP_FROM=

# An NGC API key, only if nvcr.io denies the image pull (docker login reads it, piped) or the NIM asks for it
# (it is passed to the NIM only when set). The image pulled and ran without one.
# NGC_API_KEY=
