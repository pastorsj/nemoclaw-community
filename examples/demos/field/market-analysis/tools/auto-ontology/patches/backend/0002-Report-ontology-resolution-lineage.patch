+def test_result_reports_phrase_to_ontology_lineage(
+    main: ModuleType, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    attribute = {
+        "name": "Close",
+        "query_entities": ["closing price", "closing price"],
+        "schema_name": "main",
+        "table_name": "daily_prices",
+        "source_column": "adjusted_close",
+        "score": 0.01,
+    }
+    events = _run(
+        main,
+        monkeypatch,
+        [
+            {
+                "retrieve_candidates": {
+                    "path_state": {"retrieved_column_attributes": [attribute]}
+                }
+            },
+            {
+                "format_and_respond": {
+                    "path_state": {
+                        "final_response": {
+                            "response": "NVDA closed highest.",
+                            "sql_code": "SELECT asset_id FROM daily_prices",
+                        }
+                    }
+                }
+            },
