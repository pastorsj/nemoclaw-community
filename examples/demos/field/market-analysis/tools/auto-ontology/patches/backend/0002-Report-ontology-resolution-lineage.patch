diff --git a/auto_ontology/retrieval/text_to_sql/main.py b/auto_ontology/retrieval/text_to_sql/main.py
index c2c43ed3..9ffffe03 100644
--- a/auto_ontology/retrieval/text_to_sql/main.py
+++ b/auto_ontology/retrieval/text_to_sql/main.py
@@ -157,9 +157,51 @@ def _extract_answer(final_state: dict) -> dict:
         else:
             final_response = ""
 
-    if isinstance(final_response, dict):
-        return final_response
-    return {"response": str(final_response)}
+    answer = (
+        dict(final_response)
+        if isinstance(final_response, dict)
+        else {"response": str(final_response)}
+    )
+    lineage = _resolution_lineage(path_state)
+    if lineage:
+        answer["resolution_lineage"] = lineage
+    return answer
+
+
+def _resolution_lineage(path_state: dict, limit: int = 40) -> list[dict[str, str]]:
+    """Map each extracted phrase to the ontology object and column it resolved to.
+
+    Built from the retrieved column attributes, so it reports only catalog
+    names: no scores, embeddings, prompts or model reasoning.
+    """
+    records: list[dict[str, str]] = []
+    seen: set[tuple[str, ...]] = set()
+    for candidate in path_state.get("retrieved_column_attributes") or []:
+        if not isinstance(candidate, dict) or not candidate.get("name"):
+            continue
+        schema = str(candidate.get("schema_name") or "")
+        table = str(candidate.get("table_name") or "")
+        record = {
+            "ontology_object": str(candidate["name"]),
+            "table": f"{schema}.{table}" if schema and table else table,
+            "column": str(candidate.get("source_column") or ""),
+        }
+        phrases = candidate.get("query_entities")
+        if not isinstance(phrases, list):
+            phrases = [candidate.get("query_entity")]
+        for phrase in phrases:
+            if not isinstance(phrase, str) or not phrase.strip():
+                continue
+            identity = (phrase.strip(), *record.values())
+            if identity in seen:
+                continue
+            seen.add(identity)
+            records.append(
+                {"phrase": phrase.strip(), **{k: v for k, v in record.items() if v}}
+            )
+            if len(records) == limit:
+                return records
+    return records
 
 
