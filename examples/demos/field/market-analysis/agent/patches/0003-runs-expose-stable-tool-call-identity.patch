 class TestRunEventCallback:
 
+    @pytest.mark.asyncio
+    async def test_tool_events_forward_only_safe_identity_and_summary_fields(self, adapter):
+        """Runs SSE correlates tool lifecycles without leaking arguments."""
+        run_id = "run_tool_identity"
+        loop = asyncio.get_running_loop()
+        queue = asyncio.Queue()
+        adapter._run_streams[run_id] = queue
+        adapter._run_statuses.pop(run_id, None)
+
+        callback = adapter._make_run_event_callback(run_id, loop)
+        callback(
+            "tool.started",
+            "mcp__auto_ontology__ask_question",
+            "Ontology query",
+            {"secret": "must-not-leak"},
+            tool_call_id="call-42",
+            result="must-not-leak",
+        )
+        started = await asyncio.wait_for(queue.get(), timeout=1.0)
+        assert started == {
+            "event": "tool.started",
+            "run_id": run_id,
+            "timestamp": started["timestamp"],
+            "tool": "mcp__auto_ontology__ask_question",
+            "preview": "Ontology query",
+            "tool_call_id": "call-42",
+        }
+
+        callback(
+            "tool.completed",
+            "mcp__auto_ontology__ask_question",
+            None,
+            {"secret": "must-not-leak"},
+            tool_call_id="bad\nidentity",
+            duration=1.23456,
+            is_error=False,
+            result="display-safe result",
+        )
+        completed = await asyncio.wait_for(queue.get(), timeout=1.0)
+        assert completed == {
+            "event": "tool.completed",
+            "run_id": run_id,
+            "timestamp": completed["timestamp"],
+            "tool": "mcp__auto_ontology__ask_question",
+            "duration": 1.235,
+            "error": False,
+            "preview": "display-safe result",
+        }
+
