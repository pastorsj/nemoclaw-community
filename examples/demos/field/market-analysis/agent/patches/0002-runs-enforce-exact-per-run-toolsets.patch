diff --git a/gateway/platforms/api_server_runs.py b/gateway/platforms/api_server_runs.py
index 9a2092bb69..5c3892e971 100644
--- a/gateway/platforms/api_server_runs.py
+++ b/gateway/platforms/api_server_runs.py
@@ -106,6 +106,61 @@ def _tool_completed_preview(result: Any, redact_sensitive_text: Callable[..., st
     preview = redact_sensitive_text(text, force=True)
     limit = _TOOL_COMPLETED_PREVIEW_MAX_CHARS
     return preview if len(preview) <= limit else preview[: limit - 3] + "..."
+_MAX_REQUEST_TOOLSETS = 32
+_MAX_TOOLSET_NAME_LENGTH = 128
+
+
+def _bounded_control_free_string(value: Any, *, max_length: int) -> str | None:
+    """Return a stripped bounded string without control characters, else ``None``."""
+    if not isinstance(value, str):
+        return None
+    value = value.strip()
+    if not value or len(value) > max_length:
+        return None
+    if any(ord(character) < 32 or ord(character) == 127 for character in value):
+        return None
+    return value
+
+
+def _parse_enabled_toolsets(body: dict[str, Any], *, allowed: set[str], _openai_error):
+    """Validate an optional exact, non-widening per-run toolset allowlist."""
+    if "enabled_toolsets" not in body:
+        return None, None
+    raw = body["enabled_toolsets"]
+    if not isinstance(raw, list) or len(raw) > _MAX_REQUEST_TOOLSETS:
+        return None, _json_error(
+            _openai_error,
+            f"'enabled_toolsets' must be an array of at most {_MAX_REQUEST_TOOLSETS} names",
+            code="invalid_toolsets",
+            status=400,
+        )
+    requested: list[str] = []
+    for item in raw:
+        name = _bounded_control_free_string(item, max_length=_MAX_TOOLSET_NAME_LENGTH)
+        if name is None:
+            return None, _json_error(
+                _openai_error,
+                "Each enabled toolset must be a non-empty bounded string without control characters",
+                code="invalid_toolsets",
+                status=400,
+            )
+        if name in requested:
+            return None, _json_error(
+                _openai_error,
+                f"Duplicate enabled toolset: {name}",
+                code="invalid_toolsets",
+                status=400,
+            )
+        requested.append(name)
+    unavailable = sorted(set(requested) - allowed)
+    if unavailable:
+        return None, _json_error(
+            _openai_error,
+            f"Requested toolsets are not enabled by this profile: {', '.join(unavailable)}",
+            code="invalid_toolsets",
+            status=400,
+        )
+    return requested, None
 
 
