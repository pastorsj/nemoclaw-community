 class TestStartRun:
+    @pytest.mark.asyncio
+    async def test_start_passes_exact_empty_toolset_allowlist(self, adapter):
+        app = _create_runs_app(adapter)
+        async with TestClient(TestServer(app)) as cli:
+            with patch("gateway.run._load_gateway_config", return_value={}), \
+                 patch.object(adapter, "_create_agent") as mock_create:
+                mock_agent = MagicMock()
+                mock_agent.run_conversation.return_value = {"final_response": "done"}
+                mock_agent.session_prompt_tokens = 0
+                mock_agent.session_completion_tokens = 0
+                mock_agent.session_total_tokens = 0
+                mock_create.return_value = mock_agent
+
+                response = await cli.post(
+                    "/v1/runs", json={"input": "closed-book edit", "enabled_toolsets": []})
+                assert response.status == 202
+                for _ in range(20):
+                    if mock_create.call_args is not None:
+                        break
+                    await asyncio.sleep(0.05)
+
+        assert mock_create.call_args.kwargs["enabled_toolsets_override"] == []
+
+    @pytest.mark.asyncio
+    async def test_start_rejects_toolset_widening_before_admission(self, adapter):
+        app = _create_runs_app(adapter)
+        async with TestClient(TestServer(app)) as cli:
+            with patch(
+                "gateway.run._load_gateway_config",
+                return_value={"platform_toolsets": {"api_server": ["skills_readonly"]}},
+            ), patch.object(adapter, "_create_agent") as mock_create:
+                response = await cli.post(
+                    "/v1/runs", json={"input": "question", "enabled_toolsets": ["skills"]})
+                payload = await response.json()
+
+        assert response.status == 400
+        assert payload["error"]["code"] == "invalid_toolsets"
+        assert adapter._run_statuses == {}
+        mock_create.assert_not_called()
+
