# Required. OpenShell stores this credential and substitutes it only at the
# inference egress boundary; it is never baked into the sandbox image.
NVIDIA_API_KEY=

# Required for SEC requests. The SEC asks automated clients to identify the
# caller and provide contact information. This value is not a secret.
SEC_USER_AGENT="Your Name your.email@example.com"

# Reviewed defaults. The endpoint is restricted by policy.yaml.
NEMOCLAW_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NEMOCLAW_ENDPOINT_URL=https://integrate.api.nvidia.com/v1

# Local deployment names and ports.
NEMOCLAW_SANDBOX_NAME=financial-assistant
OPENSHELL_GATEWAY=openshell
OPENSHELL_GATEWAY_ENDPOINT=https://127.0.0.1:17670
# Optional Docker context for image builds. On macOS the script automatically
# selects colima-$OPENSHELL_GATEWAY when that context exists.
NEMOCLAW_DOCKER_CONTEXT=
PHOENIX_PROJECT_NAME=financial-assistant
PHOENIX_COLLECTOR_ENDPOINT=http://host.openshell.internal:6006/v1/traces

# Optional: authenticate the checksum-pinned Hermes source download when
# GitHub's anonymous archive rate limit is exhausted.
GITHUB_TOKEN=
