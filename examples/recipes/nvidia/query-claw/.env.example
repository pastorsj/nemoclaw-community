# Copy this file to .runtime/deploy.env, keep it mode 0600, and replace the
# required placeholders. Query Claw generates the blank service credentials.

# Required clean NVIDIA GSF checkout already present on the deployment host.
# Query Claw enforces its tested commit in version-controlled deployment code.
GSF_SOURCE_DIR=/opt/query-claw/sources/gsf

# Optional clean NeMo Retriever checkout/cache. A blank value uses
# .runtime/sources/nemo-retriever.
NEMO_RETRIEVER_SOURCE_DIR=

# Optional private address overrides. Blank values are discovered on the host.
QUERY_CLAW_PRIVATE_IP=
QUERY_CLAW_PRIVATE_HOST=

# Optional external AIQ3 dataset. Set both values or leave both blank to use the
# bundled supply-chain sample. The repository must already contain the outputs
# declared by this one dataset manifest; only their normalized private copy is
# mounted into Query Claw services.
QUERY_CLAW_DATASET_REPOSITORY=
QUERY_CLAW_DATASET_MANIFEST=

# Required NVIDIA hosted inference for GSF, Retriever, and Hermes.
NVIDIA_INFERENCE_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional lower-latency GSF text-to-SQL model. A blank value uses LLM_MODEL.
ONTOLOGY_MODEL=

# Optional provider override. A blank value selects "build" for the default
# NVIDIA endpoint and "custom" for another OpenAI-compatible NVIDIA endpoint.
NEMOCLAW_PROVIDER=
# Optional NeMo Retriever endpoint/model overrides. Blank values use the
# recipe's live-qualified NVIDIA-hosted embedding and reranking defaults.
NVIDIA_EMBED_INVOKE_URL=
NVIDIA_EMBED_MODEL=
NVIDIA_EMBED_MODEL_PROVIDER_PREFIX=
NVIDIA_RERANK_INVOKE_URL=
NVIDIA_RERANK_MODEL=

# Required only for a dataset that declares prediction artifacts. Use the
# legacy KumoRFM service supported by the pinned GSF revision, not a Kumo
# Relational endpoint, website, redirect, or project-management endpoint. The
# key is optional when the endpoint does not require one. GSF routes predictions
# internally through `ask_question`.
KUMO_RFM_API_URL=
KUMO_RFM_API_KEY=

# Generated once by deploy/setup.sh when blank. Do not share these values.
POSTGRES_PASSWORD=
GSF_QUERY_PASSWORD=
GSF_ADMIN_PASSWORD=
AUTH_SECRET=
NEMO_RETRIEVER_API_TOKEN=
NRL_INTERNAL_VDB_TOKEN=

# Deployment identity. The NemoClaw, Hermes, OpenShell, and NeMo Retriever
# versions are code-owned by deployment scripts so they cannot drift through an
# environment override.
NEMOCLAW_SANDBOX_NAME=query-claw
NEMOCLAW_GATEWAY_PORT=8080
NEMOCLAW_DASHBOARD_PORT=18789
NEMOCLAW_HERMES_API_PORT=8642

# Optional authenticated HTTPS origin for a remote Hermes dashboard. Leave it
# blank for loopback-only access through `brev port-forward`.
CHAT_UI_URL=

# Optional OpenAI-compatible semantic judge with JSON Schema output support.
# Leave all three blank to run only deterministic checks. The judge receives the
# question, answer, and selected source IDs, so use a provider approved for
# evaluated data.
AIQ_JUDGE_RESPONSES_URL=
AIQ_JUDGE_MODEL=
AIQ_JUDGE_API_KEY=
