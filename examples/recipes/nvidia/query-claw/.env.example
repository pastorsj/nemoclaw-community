# Copy this file to .runtime/deploy.env, keep it mode 0600, and replace the
# required placeholders. Query Claw generates the blank service credentials.

# Required NVIDIA Ontology source already present on the deployment host.
GSF_SOURCE_DIR=/opt/query-claw/sources/gsf
GSF_SOURCE_REVISION=c9d5d17a0652fbea1a50ae63e9b8f18e1fb56d69

# Optional clean NeMo Retriever checkout/cache. A blank value uses
# .runtime/sources/nemo-retriever.
NEMO_RETRIEVER_SOURCE_DIR=

# Optional private address overrides. Blank values are discovered on the host.
QUERY_CLAW_PRIVATE_IP=
QUERY_CLAW_PRIVATE_HOST=

# Required NVIDIA hosted inference for Ontology, Retriever, and Hermes.
NVIDIA_INFERENCE_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5

# Optional lower-latency text-to-SQL model. A blank value uses LLM_MODEL.
ONTOLOGY_MODEL=

# Optional provider override. A blank value selects "build" for the default
# NVIDIA endpoint and "custom" for another OpenAI-compatible NVIDIA endpoint.
NEMOCLAW_PROVIDER=
NVIDIA_EMBED_INVOKE_URL=
NVIDIA_EMBED_MODEL=

# Required existing Kumo prediction API URL. Use its direct API base URL rather
# than a website, redirect, or project-management endpoint. The key is optional
# when the endpoint does not require one. Qualification requires the current
# `kumo-relational` model ID.
KUMO_RFM_API_URL=
KUMO_RFM_API_KEY=

# Generated once by deploy/setup.sh when blank. Do not share these values.
POSTGRES_PASSWORD=
GSF_QUERY_PASSWORD=
NEO4J_PASSWORD=
GSF_ADMIN_PASSWORD=
AUTH_SECRET=
QUERY_CLAW_MCP_TOKEN=
NEMO_RETRIEVER_API_TOKEN=
NRL_INTERNAL_VDB_TOKEN=

# Deployment identity and service pin. The NemoClaw, Hermes, and OpenShell
# versions are code-owned by deploy/setup-hermes.sh so they cannot drift through
# an environment override.
NEMO_RETRIEVER_IMAGE=nvcr.io/nvidia/nemo-microservices/nrl-service@sha256:597f0ac7404329b600669f5ece03b65fc4158f2068c2892f3cfb3df2d75add58
NEMOCLAW_SANDBOX_NAME=query-claw
NEMOCLAW_GATEWAY_PORT=8080
NEMOCLAW_DASHBOARD_PORT=18789
NEMOCLAW_HERMES_API_PORT=8642

# Optional authenticated HTTPS origin for a remote Hermes dashboard. Leave it
# blank for loopback-only access through `brev port-forward`.
CHAT_UI_URL=

# Optional OpenAI-compatible semantic judge with JSON Schema output support.
# Leave all three blank to run only deterministic checks. The judge receives the
# question, answer, and expected checks, so use a provider approved for evaluated data.
QUERY_CLAW_JUDGE_BASE_URL=
QUERY_CLAW_JUDGE_MODEL=
QUERY_CLAW_JUDGE_API_KEY=
